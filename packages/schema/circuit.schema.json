{
  "$defs": {
    "CircuitMetadata": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "default": "qiskit",
          "title": "Framework",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "title": "CircuitMetadata",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "minimum": 0,
          "title": "Layer",
          "type": "integer"
        },
        "name": {
          "enum": [
            "h",
            "x",
            "y",
            "z",
            "s",
            "sdg",
            "t",
            "tdg",
            "rx",
            "ry",
            "rz",
            "p",
            "cx",
            "cz",
            "swap",
            "ccx"
          ],
          "title": "Name",
          "type": "string"
        },
        "params": {
          "items": {
            "type": "number"
          },
          "title": "Params",
          "type": "array"
        },
        "qubits": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Qubits",
          "type": "array"
        }
      },
      "required": [
        "name",
        "qubits",
        "params",
        "layer"
      ],
      "title": "Gate",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "clbit": {
          "minimum": 0,
          "title": "Clbit",
          "type": "integer"
        },
        "qubit": {
          "minimum": 0,
          "title": "Qubit",
          "type": "integer"
        }
      },
      "required": [
        "qubit",
        "clbit"
      ],
      "title": "Measurement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Qubit 0 is the first wire; measurements occur after all gates.\n\n``layer`` records the caller's zero-based drawing position. It is not a\nsubstitute for circuit depth, which will be calculated by the analyzer.",
  "properties": {
    "gates": {
      "items": {
        "$ref": "#/$defs/Gate"
      },
      "title": "Gates",
      "type": "array"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/CircuitMetadata"
    },
    "num_clbits": {
      "minimum": 0,
      "title": "Num Clbits",
      "type": "integer"
    },
    "num_qubits": {
      "minimum": 1,
      "title": "Num Qubits",
      "type": "integer"
    }
  },
  "required": [
    "num_qubits",
    "num_clbits",
    "gates",
    "measurements",
    "metadata"
  ],
  "title": "Circuit",
  "type": "object"
}
